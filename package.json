{
  "name": "mcp-mdast",
  "version": "0.1.0",
  "description": "MCP Server for MDAST manipulation with CSS-like selectors",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-mdast": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mdast",
    "markdown",
    "remark",
    "unified",
    "ast",
    "manipulation",
    "css-selector",
    "model-context-protocol"
  ],
  "author": "mako10k",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako10k/mcp-mdast.git"
  },
  "bugs": {
    "url": "https://github.com/mako10k/mcp-mdast/issues"
  },
  "homepage": "https://github.com/mako10k/mcp-mdast#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
