{
  "name": "mcp-mdast",
  "version": "0.1.0",
  "description": "MCP Server for MDAST manipulation with CSS-like selectors",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-mdast": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": [
    "mcp",
    "mdast",
    "markdown",
    "remark",
    "unified"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
